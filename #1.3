<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
<!-- #1 
INSERT AN IMAGE -->
    <!-- Save an image in the same folder as this html file -->
    <!-- Add it to your page using the img tag -->
    <!-- Add alternate text under the alt attribute -->
    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSPn70-kwApQRGMqJBPZzsRFYq7yt-tnPdf1iqdA08kpg&s" alt="A cute puppy">


<!-- #2
RESIZE IT  -->
    <!-- Copy the image tag above, but this time add more attributes -->
    <!-- Add the width attribute, then height, then both -->
    <p><img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSPn70-kwApQRGMqJBPZzsRFYq7yt-tnPdf1iqdA08kpg&s" alt="A cute puppy" width="300"></p>

    <p><img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSPn70-kwApQRGMqJBPZzsRFYq7yt-tnPdf1iqdA08kpg&s" alt="A cute puppy" height="200"></p>

    <p><img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSPn70-kwApQRGMqJBPZzsRFYq7yt-tnPdf1iqdA08kpg&s" alt="A cute puppy" width="300" height="200"></p>


<!-- #3
ADD A SIMPLE LINK  -->
    <!-- Create a simple text link with the anchor tag "a" -->
    <!-- Use a webite url in the href attribute -->
    <p><a href="https://google.com">google</a></p>


<!-- #4
TURN AN IMAGE INTO A LINK -->
    <!-- Nest the image tag INSIDE the a tag.  -->
    <!-- You want to put it in between the open and close tags! -->
    <p>
        <a href="https://google.com">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSPn70-kwApQRGMqJBPZzsRFYq7yt-tnPdf1iqdA08kpg&s" alt="A cute puppy" height="100">
        </a>
    </p>
</body>
</html>

